{
    "name": "ernestdefoe/recipes",
    "description": "Structured recipes in posts: ingredients that scale with servings, one-click step timers, a clean print view and schema.org Recipe data for search engines. Works with Scribe, FoF Rich Text and the plain composer.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "recipe",
        "recipes",
        "cooking",
        "schema.org"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/recipes",
    "support": {
        "issues": "https://github.com/ernestdefoe/recipes/issues",
        "source": "https://github.com/ernestdefoe/recipes"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "require-dev": {
        "ernestdefoe/scribe": "^1.4",
        "flarum/bbcode": "^2.0",
        "flarum/markdown": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Recipes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Recipes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Recipes",
            "category": "feature",
            "optional-dependencies": [
                "ernestdefoe-scribe",
                "fof-rich-text",
                "flarum-markdown",
                "flarum-bbcode",
                "fof-seo"
            ],
            "icon": {
                "name": "fas fa-utensils",
                "backgroundColor": "#b5482a",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "js": true,
                "css": true,
                "locale": true
            }
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
